# Neural Network Analysis for Two-Class Data
# Using Linear Activation

import numpy as np
import matplotlib.pyplot as plt

# Two-class dataset
X = np.array([
    [1, 1],
    [2, 1],
    [2, 2],
    [3, 2],
    [6, 5],
    [7, 6],
    [8, 5],
    [9, 7]
], dtype=float)

# Class labels
y = np.array([0, 0, 0, 0, 1, 1, 1, 1], dtype=float)

# Initialize weights and bias
w = np.zeros(2)
b = 0.0

# Learning rate
learning_rate = 0.01

# Number of iterations
epochs = 1000

# Train using gradient descent
for epoch in range(epochs):

    # Linear activation
    z = np.dot(X, w) + b

    # Mean Squared Error gradients
    error = z - y

    dw = (2 / len(X)) * np.dot(X.T, error)
    db = (2 / len(X)) * np.sum(error)

    # Update weights and bias
    w = w - learning_rate * dw
    b = b - learning_rate * db

# Calculate final output
output = np.dot(X, w) + b

# Convert output to classes
predicted = (output >= 0.5).astype(int)

# Calculate accuracy
accuracy = np.mean(predicted == y)

print("Neural Network Analysis")
print("=======================")
print("Weights:", w)
print("Bias   :", round(b, 4))

print("\nActual Classes:")
print(y.astype(int))

print("\nPredicted Classes:")
print(predicted)

print("\nAccuracy:", round(accuracy * 100, 2), "%")

# Plot the two classes
plt.figure(figsize=(8, 6))

plt.scatter(
    X[y == 0, 0],
    X[y == 0, 1],
    color="blue",
    s=100,
    label="Class 0"
)

plt.scatter(
    X[y == 1, 0],
    X[y == 1, 1],
    color="red",
    s=100,
    label="Class 1"
)

# Plot decision boundary
x_values = np.linspace(0, 10, 100)

if w[1] != 0:
    y_values = (0.5 - w[0] * x_values - b) / w[1]
    plt.plot(
        x_values,
        y_values,
        color="green",
        linewidth=2,
        label="Decision Boundary"
    )

plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.title("Two-Class Neural Network with Linear Activation")
plt.legend()
plt.grid(True)
plt.show()
