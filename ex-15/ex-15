# Image Segmentation using K-Means Clustering

import cv2
import numpy as np
import matplotlib.pyplot as plt

# Load the image
image = cv2.imread("image.jpg")

# Check if image is loaded
if image is None:
    print("Error: Image not found!")
    exit()

# Convert BGR to RGB
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

# Reshape image into a 2D array of pixels
pixels = image_rgb.reshape((-1, 3))
pixels = np.float32(pixels)

# Number of clusters
K = 4

# K-Means stopping criteria
criteria = (
    cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER,
    100,
    0.2
)

# Apply K-Means clustering
compactness, labels, centers = cv2.kmeans(
    pixels,
    K,
    None,
    criteria,
    10,
    cv2.KMEANS_RANDOM_CENTERS
)

# Convert centers to integer values
centers = np.uint8(centers)

# Replace each pixel with its cluster center
segmented_pixels = centers[labels.flatten()]

# Reshape back to original image dimensions
segmented_image = segmented_pixels.reshape(image_rgb.shape)

# Display original and segmented images
plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
plt.imshow(image_rgb)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 2, 2)
plt.imshow(segmented_image)
plt.title("K-Means Segmented Image")
plt.axis("off")

plt.tight_layout()
plt.show()

# Save segmented image
cv2.imwrite(
    "segmented_image.jpg",
    cv2.cvtColor(segmented_image, cv2.COLOR_RGB2BGR)
)

print("Image Segmentation using K-Means")
print("================================")
print("Number of clusters (K):", K)
print("Image segmented successfully.")
print("Segmented image saved as: segmented_image.jpg")
