# Neural Network Analysis for Circular Data
# Using Linear Activation

import numpy as np
import matplotlib.pyplot as plt

# Generate circular dataset
np.random.seed(42)

n = 100

# Inner circle - Class 0
theta1 = np.random.uniform(0, 2 * np.pi, n)
r1 = np.random.uniform(0, 2, n)

x1 = r1 * np.cos(theta1)
y1 = r1 * np.sin(theta1)

# Outer circle - Class 1
theta2 = np.random.uniform(0, 2 * np.pi, n)
r2 = np.random.uniform(3, 5, n)

x2 = r2 * np.cos(theta2)
y2 = r2 * np.sin(theta2)

# Combine data
X = np.vstack((
    np.column_stack((x1, y1)),
    np.column_stack((x2, y2))
))

y = np.hstack((
    np.zeros(n),
    np.ones(n)
))

# Initialize weights and bias
w = np.zeros(2)
b = 0.0

# Learning rate
learning_rate = 0.01

# Number of epochs
epochs = 1000

# Train single neuron using linear activation
for epoch in range(epochs):

    # Linear activation
    output = np.dot(X, w) + b

    # Error
    error = output - y

    # Calculate gradients
    dw = (2 / len(X)) * np.dot(X.T, error)
    db = (2 / len(X)) * np.sum(error)

    # Update weights and bias
    w = w - learning_rate * dw
    b = b - learning_rate * db

# Final output
output = np.dot(X, w) + b

# Convert output to classes
predicted = (output >= 0.5).astype(int)

# Calculate accuracy
accuracy = np.mean(predicted == y)

print("Neural Network Analysis for Circular Data")
print("=========================================")
print("Weights:", w)
print("Bias   :", round(b, 4))
print("Accuracy:", round(accuracy * 100, 2), "%")

# Plot circular data
plt.figure(figsize=(8, 6))

plt.scatter(
    x1, y1,
    color="blue",
    label="Class 0",
    alpha=0.7
)

plt.scatter(
    x2, y2,
    color="red",
    label="Class 1",
    alpha=0.7
)

plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.title("Circular Data with Linear Activation")
plt.legend()
plt.grid(True)
plt.axis("equal")
plt.show()
